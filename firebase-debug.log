[debug] [2026-10-07T20:35:36.092Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/tropicolors2-67b4a/rulesets {"name":"projects/tropicolors2-67b4a/rulesets/b5f8ec1b-d756-4dcb-bd32-03ef17ec769a","source":{"files":[{"content":"rules_version = '2';\r\n\r\nservice cloud.firestore {\r\n  match /databases/{database}/documents {\r\n    function signedIn() {\r\n      return request.auth != null;\r\n    }\r\n\r\n    function isInventoryUser() {\r\n      return signedIn() &&\r\n        request.auth.token.email == \"m_tropicolorsinv@hotmail.com\";\r\n    }\r\n\r\n    function isAdminUser() {\r\n      return signedIn() &&\r\n        request.auth.token.email != \"m_tropicolorsinv@hotmail.com\";\r\n    }\r\n\r\n    function isOwnUser(uid) {\r\n      return signedIn() && request.auth.uid == uid;\r\n    }\r\n\r\n    function isTrackingStatus(status) {\r\n      return status in [\r\n        \"pendiente\",\r\n        \"pagado\",\r\n        \"enviado\",\r\n        \"entregado\",\r\n        \"cancelado\",\r\n      ];\r\n    }\r\n\r\n    function isPublicTrackingCreate(trackingToken) {\r\n      return request.resource.data.keys().hasOnly([\r\n        \"orderId\",\r\n        \"orderNumber\",\r\n        \"trackingToken\",\r\n        \"status\",\r\n        \"statusLabel\",\r\n        \"description\",\r\n        \"subtotal\",\r\n        \"shippingFee\",\r\n        \"total\",\r\n        \"currency\",\r\n        \"paymentMethod\",\r\n        \"paymentStatus\",\r\n        \"items\",\r\n        \"historial\",\r\n        \"createdAt\",\r\n        \"updatedAt\",\r\n      ]) &&\r\n        request.resource.data.orderId is string &&\r\n        request.resource.data.trackingToken == trackingToken &&\r\n        isTrackingStatus(request.resource.data.status);\r\n    }\r\n\r\n    function isPublicTrackingLookupCreate(lookupId) {\r\n      return request.resource.data.keys().hasOnly([\r\n        \"orderId\",\r\n        \"orderNumber\",\r\n        \"orderNumberLookup\",\r\n        \"trackingToken\",\r\n        \"createdAt\",\r\n        \"updatedAt\",\r\n      ]) &&\r\n        request.resource.data.orderId is string &&\r\n        request.resource.data.orderNumber is string &&\r\n        request.resource.data.orderNumberLookup == lookupId &&\r\n        request.resource.data.trackingToken is string;\r\n    }\r\n\r\n    match /products/{productId} {\r\n      allow read: if true;\r\n      allow create, update, delete: if isAdminUser();\r\n    }\r\n\r\n    match /references/{referenceId} {\r\n      allow read: if true;\r\n      allow create: if true;\r\n      allow update, delete: if isAdminUser();\r\n    }\r\n\r\n    match /orders/{orderId} {\r\n      allow create: if true;\r\n      allow read, update, delete: if isAdminUser();\r\n    }\r\n\r\n    match /order_tracking/{trackingToken} {\r\n      allow get: if true;\r\n      allow list: if false;\r\n      allow create: if isAdminUser() || isPublicTrackingCreate(trackingToken);\r\n      allow update, delete: if isAdminUser();\r\n    }\r\n\r\n    match /order_tracking_lookup/{lookupId} {\r\n      allow get: if true;\r\n      allow list: if false;\r\n      allow create: if isAdminUser() || isPublicTrackingLookupCreate(lookupId);\r\n      allow update, delete: if isAdminUser();\r\n    }\r\n\r\n    match /notifications/{notificationId} {\r\n      allow create: if true;\r\n      allow read, update, delete: if isAdminUser();\r\n    }\r\n\r\n    match /settings/home {\r\n      allow read: if true;\r\n      allow write: if isAdminUser();\r\n    }\r\n\r\n    match /users/{uid} {\r\n      allow read, create, update: if isOwnUser(uid) || isAdminUser();\r\n    }\r\n\r\n    match /runtime/admin-panel-session {\r\n      allow read, write: if isAdminUser();\r\n    }\r\n\r\n    match /productos/{productId} {\r\n      allow read, write: if isInventoryUser() || isAdminUser();\r\n    }\r\n\r\n    match /movimientos/{movementId} {\r\n      allow read, write: if isInventoryUser() || isAdminUser();\r\n    }\r\n\r\n    match /activity_logs/{logId} {\r\n      allow create, read: if isAdminUser();\r\n    }\r\n\r\n    match /pedidos/{orderId} {\r\n      allow read, write: if isAdminUser();\r\n    }\r\n\r\n    match /{document=**} {\r\n      allow read, write: if false;\r\n    }\r\n  }\r\n}\r\n","name":"firestore.rules"}]},"createTime":"2026-10-07T20:35:34.953535Z","metadata":{"services":["cloud.firestore"]}}
